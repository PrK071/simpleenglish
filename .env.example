# Copie este arquivo para ".env" e preencha com os dados do seu projeto
# Firebase (Configurações do projeto > seus apps > app da Web).
FIREBASE_API_KEY=COLE_AQUI_SUA_API_KEY
FIREBASE_AUTH_DOMAIN=COLE_AQUI_SEU_AUTH_DOMAIN
FIREBASE_PROJECT_ID=COLE_AQUI_SEU_PROJECT_ID
FIREBASE_STORAGE_BUCKET=COLE_AQUI_SEU_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=COLE_AQUI_SEU_SENDER_ID
FIREBASE_APP_ID=COLE_AQUI_SEU_APP_ID
FIREBASE_MEASUREMENT_ID=COLE_AQUI_SEU_MEASUREMENT_ID
RECAPTCHA_SITE_KEY=COLE_AQUI_SUA_CHAVE_RECAPTCHA
