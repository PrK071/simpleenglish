{
  "name": "simpleenglish-security",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:auth:backend && npm run test:rules",
    "test:unit": "node --test tests/auth-policy.test.mjs tests/csp.test.mjs",
    "test:auth:backend": "node --test tests/auth-policy.backend.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.28.1 emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "13.0.0"
  }
}
